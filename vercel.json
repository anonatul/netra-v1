{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [{ "source": "/api/:path*", "destination": "https://<YOUR-BACKEND-ON-RENDER>.onrender.com/api/:path*" }],
  "env": {
    "VITE_API_BASE": "https://<YOUR-BACKEND-ON-RENDER>.onrender.com/api/v1"
  }
}
