# Local / production environment overrides (copy to .env to use)

# --- Database (Render free Postgres auto-injects DATABASE_URL; set this for local) ---
# DATABASE_URL=postgresql+psycopg://netra:netra@localhost:5433/netra

# --- LLM enrichment (campus Qwen) ---
# Points at the college gateway. Leave as-is on campus; off-campus it will
# simply fail fast and the app degrades to rules-only (still fully functional).
LLM_ENABLED=true
AI_GATEWAY_BASE_URL=https://ai.tcetcercd.in/v1
AI_GATEWAY_MODEL=/home/user1/models/Qwen3.6-35B-A3B-NVFP4-Fast

# --- Auth ---
JWT_SECRET=change-me-in-prod

# --- CORS (backend allows * by default; set explicit origins if needed) ---
# CORS_ORIGINS=https://your-frontend.vercel.app
